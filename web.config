<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors errorMode="Detailed">
      <remove statusCode="404" />
      <error statusCode="404" responseMode="Redirect" path="/" />
    </httpErrors>
        <directoryBrowse enabled="false" />
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
  </system.webServer>
</configuration>
