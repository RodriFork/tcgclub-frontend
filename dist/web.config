<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors errorMode="Detailed">
      <remove statusCode="404" />
      <error statusCode="404" responseMode="Redirect" path="/" />
    </httpErrors>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="API Proxy" stopProcessing="true">
          <match url="^(usuario|correo|correos|mesa|mesas)(/.*)?$" />
          <action type="Rewrite" url="http://localhost:8080/src/{R:1}{R:2}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>